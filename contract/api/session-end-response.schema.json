{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "gameNo": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "medal": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gold",
                "silver",
                "bronze"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "solved": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "ok",
        "gameNo",
        "medal",
        "score",
        "solved"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "string",
          "const": "rate_limited"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
