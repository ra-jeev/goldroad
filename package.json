{
	"name": "goldroad",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "pnpm run build && wrangler dev",
		"postinstall": "nuxt prepare",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "nuxt typecheck",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply goldroad --local",
		"db:studio": "drizzle-kit studio",
		"db:seed:local": "pnpm exec tsx scripts/generate-dev-seed.ts && wrangler d1 execute goldroad --local --file server/db/seeds/dev_seed.sql",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:api": "pnpm exec tsx scripts/check-api-routes.ts"
	},
	"dependencies": {
		"@vueuse/core": "^14.3.0",
		"@vueuse/nuxt": "^14.3.0",
		"drizzle-orm": "^0.45.2",
		"nuxt": "^4.4.8",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-zod": "^0.8.3",
		"h3": "^1.15.11",
		"nitro-cloudflare-dev": "^0.2.2",
		"nitropack": "^2.13.4",
		"sharp": "^0.35.3",
		"tsx": "^4.23.1",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.7",
		"wrangler": "^4.110.0"
	}
}