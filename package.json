{
	"name": "goldroad",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "pnpm run build && wrangler dev",
		"postinstall": "nuxt prepare",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "nuxt typecheck",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply goldroad --local",
		"db:studio": "drizzle-kit studio",
		"db:seed:local": "wrangler d1 execute goldroad --local --file server/db/seeds/dev_seed.sql",
		"test:api": "node scripts/check-api-routes.mjs"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"nuxt": "^4.4.2",
		"vue": "^3.5.31",
		"vue-router": "^5.0.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-zod": "^0.8.3",
		"h3": "^1.15.10",
		"nitro-cloudflare-dev": "^0.2.2",
		"nitropack": "^2.13.3",
		"tsx": "^4.21.0",
		"vue-tsc": "^3.2.6",
		"wrangler": "^4.79.0"
	}
}