/**
 * Cloudflare Worker configuration.
 *
 * The top-level bindings are used only by local Wrangler/Nitro development.
 * Remote deploys must always select an explicit environment.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "goldroad-local",
	"account_id": "e94e51718248bf1c5c9fd3eb4db6a7a7",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2026-07-14",
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "goldroad-local",
			"database_id": "88cad6fe-39f1-409d-adb1-7ec3724e6e07",
			"migrations_dir": "server/db/migrations"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "3002",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"env": {
		"staging": {
			"name": "goldroad-v2-staging",
			"workers_dev": true,
			"routes": [
				{
					"pattern": "v2.playgoldroad.com",
					"custom_domain": true
				}
			],
			"triggers": {
				"crons": [
					"0 0 * * *"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "goldroad-v2-staging",
					"database_id": "88cad6fe-39f1-409d-adb1-7ec3724e6e07",
					"migrations_dir": "server/db/migrations"
				}
			],
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "3004",
					"simple": {
						"limit": 20,
						"period": 60
					}
				}
			]
		},
		"production": {
			"name": "goldroad-v2-production",
			"workers_dev": false,
			"triggers": {
				"crons": [
					"0 0 * * *"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "goldroad-v2-production",
					"database_id": "180cc3df-c03d-4301-9f3d-f5fe359d90bf",
					"migrations_dir": "server/db/migrations"
				}
			],
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "3003",
					"simple": {
						"limit": 20,
						"period": 60
					}
				}
			]
		}
	}
}
